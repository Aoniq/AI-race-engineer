# --- Microsoft Foundry -------------------------------------------------------
# Resource endpoint from the Foundry portal (Overview / "Azure OpenAI endpoint"), e.g.
#   https://my-boxbox.openai.azure.com/   or   https://my-boxbox.cognitiveservices.azure.com/
FOUNDRY_ENDPOINT=
# API key from the same page. Leave empty to sign in with Microsoft Entra ID (az login).
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2025-04-01-preview

# Deployment names (the names YOU gave the deployments, not necessarily the model names)
FOUNDRY_CHAT_DEPLOYMENT=gpt-5.4-mini
FOUNDRY_TTS_DEPLOYMENT=gpt-4o-mini-tts
FOUNDRY_STT_DEPLOYMENT=gpt-4o-mini-transcribe

# Reasoning effort for gpt-5 family chat models (none/minimal/low/medium/high).
# Dropped automatically if your chat model doesn't support it.
FOUNDRY_REASONING_EFFORT=low
FOUNDRY_RADIO_REASONING_EFFORT=low

# Engineer voice: alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse
FOUNDRY_TTS_VOICE=onyx
FOUNDRY_TTS_SPEED=1.1
# FOUNDRY_TTS_INSTRUCTIONS=You are a calm, focused Formula 1 race engineer on team radio.

# Language you speak on the radio and the engineer answers in (en, nl, de, fr, es, ...)
RADIO_LANGUAGE=en

# --- Driving coach --------------------------------------------------------------
# Spoken coaching after a lap: auto (driving tips in practice/quali/TT, tyre tips in races),
# always, or off (screen + radio questions only)
COACH_VOICE=auto
COACH_RACE_EVERY_LAPS=3
COACH_MIN_LOSS_S=0.08

# --- Telemetry ----------------------------------------------------------------
F1_PORT=20777
GT7_PORT=33740
ANALYSIS_INTERVAL=15
